// Prisma schema for QRNote platform
// Connects to the Supabase PostgreSQL database via a dedicated
// `prisma` role (BYPASSRLS) so server-side queries are not filtered
// by auth.uid(). The auth schema is referenced for the FK to
// auth.users but that table is managed by Supabase, not by Prisma.

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  schemas  = ["public"]
}

model Profile {
  id           String   @id @db.Uuid
  email        String   @unique
  fullName     String?  @map("full_name")
  avatarUrl    String?  @map("avatar_url")
  isSuperAdmin Boolean  @default(false) @map("is_super_admin")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime @default(now()) @map("updated_at") @db.Timestamptz
  orders       Order[]

  @@map("profiles")
  @@schema("public")
}

model Organization {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  slug      String   @unique
  logoUrl   String?  @map("logo_url")
  ownerId   String   @map("owner_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz

  members    OrganizationMember[]
  workspaces Workspace[]
  invites    OrgInvite[]

  @@map("organizations")
  @@schema("public")
}

model OrganizationMember {
  id        String   @id @default(uuid()) @db.Uuid
  orgId     String   @map("org_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  role      Role     @default(editor)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, userId])
  @@map("organization_members")
  @@schema("public")
}

enum Role {
  owner
  admin
  editor
  viewer

  @@schema("public")
}

model OrgInvite {
  id        String   @id @default(uuid()) @db.Uuid
  orgId     String   @map("org_id") @db.Uuid
  email     String
  role      Role     @default(editor)
  token     String   @unique
  accepted  Boolean  @default(false)
  expiresAt DateTime @map("expires_at") @db.Timestamptz
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, email])
  @@map("org_invites")
  @@schema("public")
}

model Workspace {
  id        String   @id @default(uuid()) @db.Uuid
  orgId     String   @map("org_id") @db.Uuid
  name      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz

  org     Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  folders Folder[]
  qrCodes QrCode[]

  @@map("workspaces")
  @@schema("public")
}

model Folder {
  id          String   @id @default(uuid()) @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  parentId    String?  @map("parent_id") @db.Uuid
  name        String
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @default(now()) @map("updated_at") @db.Timestamptz

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  parent    Folder?   @relation("FolderChildren", fields: [parentId], references: [id], onDelete: Cascade)
  children  Folder[]  @relation("FolderChildren")
  qrCodes   QrCode[]

  @@map("folders")
  @@schema("public")
}

enum QrStatus {
  active
  paused
  archived

  @@schema("public")
}

model QrCode {
  id             String   @id @default(uuid()) @db.Uuid
  workspaceId    String   @map("workspace_id") @db.Uuid
  folderId       String?  @map("folder_id") @db.Uuid
  createdBy      String   @map("created_by") @db.Uuid
  name           String
  type           String
  isDynamic      Boolean  @default(false) @map("is_dynamic")
  shortCode      String?  @unique @map("short_code")
  destinationUrl String?  @map("destination_url")
  payload        Json     @default("{}")
  style          Json     @default("{}")
  status         QrStatus @default(active)
  scanCount      Int      @default(0) @map("scan_count")

  // New fields for expiry
  expiresAt DateTime? @map("expires_at") @db.Timestamptz

  // New fields for A/B testing
  variant  String? // "A" or "B" or null for non-test QR codes
  testName String? @map("test_name")
  testId   String? @map("test_id")

  tags      Tag[]    @relation("QrCodeTags")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz

  workspace Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  folder    Folder?     @relation(fields: [folderId], references: [id], onDelete: SetNull)
  scans     ScanEvent[]

  @@map("qr_codes")
  @@schema("public")
}

model Tag {
  id          String   @id @default(uuid()) @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  name        String
  color       String   @default("#6b7280")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  qrCodes QrCode[] @relation("QrCodeTags")

  @@unique([workspaceId, name])
  @@map("tags")
  @@schema("public")
}

model ScanEvent {
  id          String   @id @default(uuid()) @db.Uuid
  qrId        String   @map("qr_id") @db.Uuid
  scannedAt   DateTime @default(now()) @map("scanned_at") @db.Timestamptz
  ipHash      String?  @map("ip_hash")
  country     String?
  region      String?
  city        String?
  browser     String?
  os          String?
  device      String?
  language    String?
  referrer    String?
  userAgent   String?  @map("user_agent")
  utmSource   String?  @map("utm_source")
  utmMedium   String?  @map("utm_medium")
  utmCampaign String?  @map("utm_campaign")

  qr QrCode @relation(fields: [qrId], references: [id], onDelete: Cascade)

  @@map("scan_events")
  @@schema("public")
}

// ------------------------- Payments Models -------------------------

enum OrderStatus {
  open
  paid
  failed
  refunded

  @@schema("public")
}

model Plan {
  id          String    @id @default(uuid()) @db.Uuid
  name        String
  price       Int // price in paise (e.g., ₹100 => 10000)
  currency    String    @default("INR")
  description String?
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime  @default(now()) @map("updated_at") @db.Timestamptz
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz

  orders Order[]

  @@map("plans")
  @@schema("public")
}

model Coupon {
  id         String    @id @default(uuid()) @db.Uuid
  code       String    @unique
  type       String
  amount     Int
  usageLimit Int?
  usedCount  Int       @default(0)
  validFrom  DateTime?
  validUntil DateTime?
  active     Boolean   @default(true)
  createdAt  DateTime  @default(now())

  // Add this line to map the reverse relation lookup link
  orders Order[]

  @@map("coupons")
  @@schema("public")
}

model Order {
  id              String      @id @default(uuid()) @db.Uuid
  planId          String?     @map("plan_id") @db.Uuid
  plan            Plan?       @relation(fields: [planId], references: [id], onDelete: SetNull)
  userId          String?     @map("user_id") @db.Uuid
  user            Profile?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  razorpayOrderId String?     @unique @map("razorpay_order_id")
  amount          Int
  currency        String      @default("INR")
  receipt         String?
  status          OrderStatus @default(open)
  createdAt       DateTime    @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime    @default(now()) @map("updated_at") @db.Timestamptz

  // Add these three fields to track the discount transaction properties
  discount Int     @default(0)
  couponId String? @map("coupon_id") @db.Uuid
  coupon   Coupon? @relation(fields: [couponId], references: [id], onDelete: SetNull)

  payments Payment[]

  @@map("orders")
  @@schema("public")
}

model Payment {
  id                String   @id @default(uuid()) @db.Uuid
  orderId           String   @map("order_id") @db.Uuid
  order             Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  razorpayPaymentId String   @unique @map("razorpay_payment_id")
  razorpaySignature String?  @map("razorpay_signature")
  status            String
  method            String?
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@map("payments")
  @@schema("public")
}

model AiConversation {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  title     String   @default("New chat")
  modelId   String?  @map("model_id")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz

  messages      AiMessage[]
  aiAttachments AiAttachment[]

  @@index([userId, updatedAt])
  @@index([userId, createdAt])
  @@map("ai_conversations")
  @@schema("public")
}

model AiMessage {
  id             String   @id
  conversationId String   @map("conversation_id") @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  role           String
  parts          Json
  modelId        String?  @map("model_id")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  conversation AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([userId, createdAt])
  @@map("ai_messages")
  @@schema("public")
}

model AiAttachment {
  id             String  @id @default(uuid()) @db.Uuid
  userId         String  @map("user_id") @db.Uuid
  conversationId String? @map("conversation_id") @db.Uuid

  fileName    String @map("file_name")
  mimeType    String @map("mime_type")
  sizeBytes   BigInt @map("size_bytes")
  storagePath String @unique @map("storage_path")

  extractedText String? @map("extracted_text")
  status        String  @default("processing")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz

  conversation AiConversation? @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  chunks AiDocumentChunk[]

  @@index([userId, createdAt])
  @@index([conversationId, createdAt])
  @@map("ai_attachments")
  @@schema("public")
}

model AiDocumentChunk {
  id           String                      @id @default(uuid()) @db.Uuid
  attachmentId String                      @map("attachment_id") @db.Uuid
  userId       String                      @map("user_id") @db.Uuid
  chunkIndex   Int                         @map("chunk_index")
  content      String
  embedding    Unsupported("vector(1536)")
  createdAt    DateTime                    @default(now()) @map("created_at")

  attachment AiAttachment @relation(fields: [attachmentId], references: [id], onDelete: Cascade)

  @@unique([attachmentId, chunkIndex])
  @@index([userId])
  @@map("ai_document_chunks")
  @@schema("public")
}
