model CustomerLead {
  id         String   @id @default(uuid()) @db.Uuid
  scanId     String?  @map("scan_id") @db.Uuid
  scan       ScanEvent? @relation(fields: [scanId], references: [id], onDelete: SetNull)
  name       String?
  email      String?  @unique
  phone      String?
  optedIn    Boolean  @default(false)
  consentAt  DateTime? @map("consent_at") @db.Timestamptz
  ipHash     String?  @map("ip_hash")
  metadata   Json?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@map("customer_leads")
  @@schema("public")
}

model DataDeletionRequest {
  id              String   @id @default(uuid()) @db.Uuid
  requesterEmail  String   @map("requester_email")
  requesterIpHash String?  @map("requester_ip_hash")
  status          String   @default("pending")
  requestedAt     DateTime @default(now()) @map("requested_at") @db.Timestamptz
  processedAt     DateTime? @map("processed_at") @db.Timestamptz
  processedBy     String?  @map("processed_by") @db.Uuid
  note            String?

  @@map("data_deletion_requests")
  @@schema("public")
}
